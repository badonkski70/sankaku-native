<?xml version="1.0" encoding="utf-8"?>
<!-- Nav icon: a small diamond blooms into a full disc. Both states are one
     M + four C + Z so the pathData morph is legal (AVD requires matching
     command structure); only the node positions differ. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="root"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="icon"
                    android:fillColor="#FF000000"
                    android:pathData="M12,7.4 C13.53,8.93 15.07,10.47 16.6,12 C15.07,13.53 13.53,15.07 12,16.6 C10.47,15.07 8.93,13.53 7.4,12 C8.93,10.47 10.47,8.93 12,7.4 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="icon">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:valueFrom="M12,7.4 C13.53,8.93 15.07,10.47 16.6,12 C15.07,13.53 13.53,15.07 12,16.6 C10.47,15.07 8.93,13.53 7.4,12 C8.93,10.47 10.47,8.93 12,7.4 Z"
                android:valueTo="M12,3 C16.97,3 21,7.03 21,12 C21,16.97 16.97,21 12,21 C7.03,21 3,16.97 3,12 C3,7.03 7.03,3 12,3 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
    <!-- the pop: hold at 0, then decelerate out. Same shape as Mihon's. -->
    <target android:name="root">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="66"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:valueFrom="0" android:valueTo="0" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="100"
                    android:startOffset="66"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="66"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:valueFrom="0" android:valueTo="0" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="100"
                    android:startOffset="66"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
