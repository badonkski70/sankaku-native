<?xml version="1.0" encoding="utf-8"?>
<!-- Nav icon: a stubby arrow over a narrow tray grows to the full glyph.
     Both states keep the same 15 commands (M h V H v h l l z M v h v H z). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="root"
                android:pivotX="12"
                android:pivotY="12"
                android:scaleX="1"
                android:scaleY="1">
                <path
                    android:name="icon"
                    android:fillColor="#FF000000"
                    android:pathData="M19,11 h-4 V5 H9 v6 H7 l5,5 5,-5 z M7,18 v2 h10 v-2 H7 z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="icon">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:valueFrom="M19,11 h-4 V5 H9 v6 H7 l5,5 5,-5 z M7,18 v2 h10 v-2 H7 z"
                android:valueTo="M19,9 h-4 V3 H9 v6 H5 l7,7 7,-7 z M5,18 v2 h14 v-2 H5 z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
    <target android:name="root">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="66"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:valueFrom="0" android:valueTo="0" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="100"
                    android:startOffset="66"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="66"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:valueFrom="0" android:valueTo="0" android:valueType="floatType" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="100"
                    android:startOffset="66"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
